{
  "name": "SatyamCRM-Desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the Satyam CRM web app",
  "author": "SatyamCRM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle-frontend.js",
    "dist": "npm run bundle && rimraf dist && electron-builder --win portable",
    "dist:ps": "powershell -NoProfile -Command \"$env:CSC_IDENTITY_AUTO_DISCOVERY='false'; npm run bundle; if (Test-Path dist) { Remove-Item -Recurse -Force dist }; npx electron-builder --win portable\""
  },
  "build": {
    "appId": "com.satyam.crm.desktop",
    "productName": "SatyamCRM",
    "files": [
      "main.js",
      "server-launcher.js",
      "app-icon.png"
    ],
    "extraResources": [
      {
        "from": "frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app-icon.png",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "SatyamCRM-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^24.13.0",
    "electron-packager": "^17.1.2",
    "rimraf": "^5.0.1"
  }
}
