{
  "name": "SatyamCRM-Desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the Satyam CRM web app",
  "author": "SatyamCRM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "rimraf dist && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.satyam.crm.desktop",
    "productName": "SatyamCRM",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app-icon.ico",
      "signAndEditExecutable": false,
      "sign": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "SatyamCRM-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^24.13.0",
    "electron-packager": "^17.1.2",
    "rimraf": "^5.0.1"
  }
}
